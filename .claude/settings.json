{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-tool-block-dangerous.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/post-tool-format.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/post-tool-run-tests.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/post-tool-no-hardcoded-secrets.sh"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/post-tool-audit-log.sh"
          }
        ]
      }
    ]
  }
}
