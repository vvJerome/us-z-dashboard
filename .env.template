# Copy to .env and fill in all values before running docker compose.
# Never commit .env — it is listed in .gitignore.

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=scraper
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql+asyncpg://scraper:change-me-strong-password@postgres:5432/scraper

# ── JWT (deferred — not wired yet, set placeholder) ─────────────────────────
JWT_SECRET_KEY=change-me-32-char-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=8

# ── Kestra ──────────────────────────────────────────────────────────────────
KESTRA_BASE_URL=http://kestra:8080
KESTRA_WEBHOOK_KEY=change-me-webhook-secret

# ── GitHub Container Registry ───────────────────────────────────────────────
GITHUB_ORG=your-github-org   # must be lowercase — GHCR rejects mixed-case image names
IMAGE_TAG=latest

# ── us-z-3 Pipeline (injected into pipeline containers by Kestra) ────────────
SERPER_API_KEY=
ZUHAL_API_KEY=

# Racknerd SMTP proxy backend
RACKNERD_HOST=vps.example.com
RACKNERD_SSH_USER=egress
RACKNERD_SSH_KEY_PATH=/root/.ssh/racknerd_egress
RACKNERD_SSH_PORT=22
RACKNERD_SOCKS_PORT=1080

# bbops.io email verifier
BBOPS_BASE_URL=https://email-verifier.bbops.io

# ── Data volume ──────────────────────────────────────────────────────────────
# DATA_DIR is fixed at /data inside containers — do not change.
