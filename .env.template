# Copy to .env and fill in all values before running docker compose.
# Never commit .env — it is listed in .gitignore.

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=scraper
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql+asyncpg://scraper:change-me-strong-password@postgres:5432/scraper

# ── JWT (deferred — not wired yet, set placeholder) ─────────────────────────
JWT_SECRET_KEY=change-me-32-char-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=8

# ── Worker VPS (universal-scraper-v3) ────────────────────────────────────────
# The dashboard triggers scrape runs on this box over SSH + tmux. Pipeline
# secrets (SERPER_API_KEY, ZUHAL_API_KEY, Cherry/Racknerd, BBOPS) live in the
# worker's own .env — they are NOT set here.
WORKER_SSH_HOST=95.217.63.54
WORKER_SSH_USER=devonly
WORKER_SSH_PORT=22
WORKER_SSH_KEY_PATH=/root/.ssh/id_worker_v3
WORKER_DATA_DIR=/home/devonly/data
WORKER_REPO_DIR=/home/devonly/projects/universal-scraper-v3

# ── GitHub Container Registry ───────────────────────────────────────────────
GITHUB_ORG=your-github-org   # must be lowercase — GHCR rejects mixed-case image names
IMAGE_TAG=latest

# ── Data volume ──────────────────────────────────────────────────────────────
# DATA_DIR is fixed at /data inside containers — do not change.
